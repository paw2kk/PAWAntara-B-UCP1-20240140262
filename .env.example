# Salin file ini jadi .env lalu isi nilainya sendiri.
# .env TIDAK ikut ter-commit (lihat .gitignore) supaya kredensial tidak bocor ke repo publik.

PORT=3000

# Ganti dengan string acak yang panjang saat production
SESSION_SECRET=ganti-dengan-secret-acak-yang-panjang

# Username admin untuk login dashboard
ADMIN_USERNAME=admin

# Jangan taruh password plain text di sini.
# Generate hash bcrypt-nya dulu lewat:
#   node scripts/generate-hash.js "passwordkamu"
# lalu tempel hasilnya di bawah ini.
ADMIN_PASSWORD_HASH=

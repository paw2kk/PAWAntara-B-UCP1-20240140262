<div class="bg-[#321E48] text-[#D9FFF4] text-xs text-center py-1.5 px-4">
  Buka setiap hari 07.00–20.00 &middot; Stok &amp; harga diperbarui tiap hari
</div>

<header class="bg-white sticky top-0 z-50 border-b border-[#D9FFF4]">
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-4" aria-label="Navigasi utama">
    <a href="/" class="flex items-center gap-2 text-[#321E48]">
      <span class="w-9 h-9 rounded-full bg-[#321E48] text-[#65DCD5] flex items-center justify-center text-lg" aria-hidden="true">🛒</span>
      <span class="font-display font-semibold text-lg tracking-tight">Toko Ariesta</span>
    </a>

    <button
      id="hamburger-btn"
      class="md:hidden text-2xl text-[#321E48] focus:outline-none"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      ☰
    </button>

    <ul
      id="nav-menu"
      class="hidden md:flex items-center flex-col md:flex-row gap-1 md:gap-8 font-medium text-sm w-full md:w-auto mt-4 md:mt-0"
    >
      <li><a href="/" class="block py-2 md:py-0 text-[#321E48] hover:text-[#43637E]">Beranda</a></li>
      <li><a href="/produk" class="block py-2 md:py-0 text-[#321E48] hover:text-[#43637E]">Produk</a></li>
      <li><a href="/tanya-ai" class="block py-2 md:py-0 text-[#321E48] hover:text-[#43637E]">Tanya AI</a></li>
      <% if (locals.isLoggedIn) { %>
        <li><a href="/dashboard" class="block py-2 md:py-0 text-[#321E48] hover:text-[#43637E]">Dashboard</a></li>
        <li class="md:ml-2">
          <button
            type="button"
            id="navbar-logout-btn"
            class="hidden md:inline-block bg-[#321E48] text-white text-sm px-4 py-2 rounded-full hover:bg-[#43637E] transition-colors"
          >
            Logout (<%= adminUsername %>)
          </button>
        </li>
      <% } else { %>
        <li class="md:ml-2">
          <a href="/login" class="hidden md:inline-block bg-[#321E48] text-white text-sm px-4 py-2 rounded-full hover:bg-[#43637E] transition-colors">
            Login Admin
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
</header>

<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-[#D9FFF4]/20 text-[#321E48] flex flex-col min-h-screen">
  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
    <% if (!product) { %>
      <section class="text-center py-16" aria-labelledby="not-found-title">
        <h1 id="not-found-title" class="text-2xl font-bold text-red-600">Produk Tidak Ditemukan</h1>
        <p class="mt-3 text-gray-500">Maaf, produk yang kamu cari tidak tersedia.</p>
        <a
          href="/produk"
          class="inline-block mt-6 bg-[#321E48] text-white px-6 py-2 rounded-lg hover:bg-[#43637E]"
        >
          Kembali ke Daftar Produk
        </a>
      </section>
    <% } else { %>
      <article>
        <a href="/produk" class="text-sm text-[#43637E] hover:underline">&larr; Kembali</a>
        <h1 class="text-3xl font-bold mt-3"><%= product.name %></h1>
        <span class="inline-block text-xs uppercase bg-[#D9FFF4] text-[#321E48] px-2 py-0.5 rounded-full mt-1"><%= product.category %></span>
        <p class="text-2xl text-[#43637E] font-bold mt-4">Rp <%= product.price.toLocaleString('id-ID') %></p>
        <p class="text-gray-500 mt-1">Stok tersedia: <%= product.stock %></p>
        <p class="mt-4 text-gray-700"><%= product.description %></p>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
